<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base Application Theme - Night -->
    <style name="Base.Theme.SakuBijak" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary colors (Biru yang lebih pekat & gelap) -->
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorPrimaryVariant">@color/primary_blue</item>
        <item name="colorOnPrimary">@android:color/white</item>

        <!-- Secondary colors (Aksen & Warna Tambahan/Kuning yang Diredupkan) -->
        <item name="colorSecondary">@color/accent_blue</item>
        <item name="colorSecondaryVariant">@color/primary_blue</item>
        <item name="colorOnSecondary">@android:color/white</item>

        <!-- Background colors (Sangat Gelap / OLED Friendly) -->
        <item name="android:colorBackground">@color/background_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnBackground">@color/text_primary_dark</item>
        <item name="colorOnSurface">@color/text_primary_dark</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/text_primary_dark</item>
        <item name="android:textColorSecondary">@color/text_secondary_dark</item>
        <item name="android:textColorHint">@color/text_hint_dark</item>

        <!-- Material Components (Nama Style disamakan dengan mode terang) -->
        <item name="materialButtonStyle">@style/Widget.SakuBijak.Button</item>
        <item name="textInputStyle">@style/Widget.SakuBijak.TextInputLayout</item>
        <item name="bottomNavigationStyle">@style/Widget.SakuBijak.BottomNavigationView</item>
    </style>

    <style name="Theme.SakuBijak" parent="Base.Theme.SakuBijak" />

    <!-- ================================ -->
    <!-- TextInputLayout Styles -->
    <!-- ================================ -->

    <style name="Widget.SakuBijak.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/primary_blue_dark</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="hintTextColor">@color/primary_blue_dark</item>
        <item name="android:textColorHint">@color/text_hint_dark</item>
        <item name="errorTextColor">@color/danger_red</item>
        <item name="startIconTint">@color/primary_blue_dark</item>
        <item name="endIconTint">@color/text_secondary_dark</item>
    </style>

    <!-- ================================ -->
    <!-- CardView Styles -->
    <!-- ================================ -->

    <style name="Widget.SakuBijak.CardView" parent="CardView">
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/surface_dark</item>
    </style>

    <!-- ================================ -->
    <!-- Bottom Navigation Style -->
    <!-- ================================ -->

    <style name="Widget.SakuBijak.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="itemIconTint">@color/bottom_nav_color_blue</item>
        <item name="itemTextColor">@color/bottom_nav_color_blue</item>
        <item name="itemRippleColor">@color/primary_blue_dark</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="android:background">@color/surface_dark</item>
        <item name="elevation">8dp</item>
    </style>

    <!-- ================================ -->
    <!-- Toolbar/AppBar Styles -->
    <!-- ================================ -->

    <style name="Widget.SakuBijak.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextColor">@color/text_primary_dark</item>
        <item name="subtitleTextColor">@color/text_secondary_dark</item>
        <item name="android:background">@color/surface_dark</item>
        <item name="popupTheme">@style/ThemeOverlay.SakuBijak.Popup</item>
    </style>

    <style name="ThemeOverlay.SakuBijak.Popup" parent="ThemeOverlay.Material3.Dark">
        <item name="colorPrimary">@color/primary_blue_dark</item>
    </style>

</resources>