<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_wallet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/card_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Icon Dompet -->
        <ImageView
            android:id="@+id/img_wallet_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@android:drawable/ic_menu_agenda"
            android:background="@drawable/bg_circle_icon"
            android:padding="8dp"
            app:tint="@color/primary_blue"
            android:contentDescription="Icon Wallet" />

        <!-- Detail Informasi Dompet -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:id="@+id/tv_wallet_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Dompet Utama / BCA"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <!-- TAMBAHAN: Nomor Wallet Unik -->
            <TextView
                android:id="@+id/tv_wallet_no"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="WAL-20260826-A1B2"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tv_wallet_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Personal"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tv_wallet_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Rp 5.000.000"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/primary_blue"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Indikator Wallet Aktif (Centang) -->
        <ImageView
            android:id="@+id/iv_active_status"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/checkbox_on_background"
            app:tint="@color/primary_blue"
            android:visibility="gone"
            tools:visibility="visible"
            android:contentDescription="Status Aktif" />

        <!-- Tombol Menu Titik Tiga -->
        <ImageView
            android:id="@+id/btn_wallet_options"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_more"
            app:tint="@color/text_secondary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Opsi Dompet"
            android:layout_marginStart="8dp"
            android:visibility="gone"
            tools:visibility="visible"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>