<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@android:color/white"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Icon Kategori / Tipe Transaksi -->
        <ImageView
            android:id="@+id/iv_transaction_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_send"
            android:padding="8dp"
            android:background="@drawable/circle_background"
            app:tint="@color/teal_700"
            android:contentDescription="Icon Transaksi" />

        <!-- Info Transaksi (Kategori, Catatan/Deskripsi, Tanggal) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp">

            <!-- Nama Kategori -->
            <TextView
                android:id="@+id/tv_transaction_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#212121"
                tools:text="Makanan &amp; Minuman" />

            <!-- Deskripsi / Catatan Tambahan -->
            <TextView
                android:id="@+id/tv_transaction_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#757575"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="2dp"
                tools:text="Makan siang resto" />

            <!-- Tanggal Transaksi -->
            <TextView
                android:id="@+id/tv_transaction_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="#9E9E9E"
                android:layout_marginTop="2dp"
                tools:text="01 Sep 2026, 12:30" />
        </LinearLayout>

        <!-- Nominal Transaksi (Warna disesuaikan Income/Expense) -->
        <TextView
            android:id="@+id/tv_transaction_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#F44336"
            tools:text="- Rp 50.000" />

    </LinearLayout>
</androidx.cardview.widget.CardView>